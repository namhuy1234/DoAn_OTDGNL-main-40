# Sao chép thành .env rồi điền giá trị thật (tệp .env không đưa lên GitHub).
DB_CONNECTION_STRING=DRIVER={ODBC Driver 17 for SQL Server};SERVER=localhost\SQLEXPRESS;DATABASE=OnThiDGNL_DB;Trusted_Connection=yes;TrustServerCertificate=yes;
# Khóa ký JWT, tối thiểu 32 ký tự: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
# Cloudinary Console > Settings > API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=ontidgnl/cau-hoi
